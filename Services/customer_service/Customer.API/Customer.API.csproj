<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Customer.BLL\Customer.BLL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../Contracts/Protos/restaurant.proto" GrpcServices="Client" />
    <Protobuf Include="../../../Contracts/Protos/customer.proto" Link="Protos/customer.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Shared/RestaurantIsolation/RestaurantScopeInterceptor.cs" Link="RestaurantIsolation/RestaurantScopeInterceptor.cs" />
  </ItemGroup>
</Project>
