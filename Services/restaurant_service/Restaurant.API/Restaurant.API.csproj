<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>815a2d0b-9704-4e92-a294-313ef86b31de</UserSecretsId>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Restaurant.BLL\Restaurant.BLL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../Contracts/Protos/restaurant.proto" Link="Protos\restaurant.proto" GrpcServices="Server" />
    <Protobuf Include="../../../Contracts/Protos/identity.proto" Link="Protos\identity.proto" GrpcServices="Client" />
    <Protobuf Include="../../../Contracts/Protos/ordering.proto" Link="Protos\ordering.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
