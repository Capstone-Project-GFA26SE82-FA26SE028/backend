<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Billing.BLL\Billing.BLL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../Contracts/Protos/billing.proto" Link="Protos/billing.proto" GrpcServices="Server" />
    <Protobuf Include="../../../Contracts/Protos/restaurant.proto" Link="Protos/restaurant.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>

