{
    "AllowedHosts":  "*",
    "GrpcServices": {
        "Restaurant": "http://restaurant:5002"
    },
    "CashRegisterAccess": {
        "ManagerRoleIds": ["manager"],
        "CashierRoleIds": ["cashier"]
    },
    "RestaurantAccess": {
        "TimeoutSeconds": 5
    },
    "Kestrel":  {
                    "Endpoints":  {
                                      "Http":  {
                                                   "Protocols":  "Http2",
                                                   "Url":  "http://0.0.0.0:5007"
                                               }
                                  }
                },
    "Logging":  {
                    "LogLevel":  {
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Default":  "Information"
                                 }
                }
}
