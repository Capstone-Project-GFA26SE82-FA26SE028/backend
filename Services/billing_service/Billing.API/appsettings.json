{
    "PayOs": {
    "Enabled": false,
    "BaseUrl": "https://api-merchant.payos.vn",
    "LinkLifetimeMinutes": 15,
    "RequestTimeoutSeconds": 10,
    "ReconcileIntervalSeconds": 30,
    "ReconcileBatchSize": 20,
    "PaidReconcileHours": 24,
    "ReturnUrl": "",
    "CancelUrl": "",
    "WebhookUrl": "",

    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": ""
},
    "CashPayment": { "MethodCode": "Cash" },
    "Billing": { "Currency": "VND", "OrderPriceBasis": "Exclusive" },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts": "*",
    "GrpcServices": {
        "Identity": "https://localhost:5001",
        "Ordering": "https://localhost:5004",
        "Restaurant": "https://localhost:5002"
    },
    "CashRegisterAccess": {
        "ManagerRoleIds": ["manager"],
        "CashierRoleIds": ["cashier"],
        "WaiterRoleIds": ["waiter"]
    },
    "RestaurantAccess": {
        "TimeoutSeconds": 5
    },
    "Kestrel": {
        "Endpoints": {
            "Https": {
                "Url": "https://localhost:5007",
                "Protocols": "Http2"
            }
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost;Database=BillingDb_Local;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
    },
  "PaymentProviderConfiguration": {
    "WebhookBaseUrl": "",
    "KeyDirectory": "App_Data/payment-keys"
  },
  "Notifications": {
    "ServiceKey": ""
  },
  "Takeaway": {
    "ServiceKey": ""
  }
}
