{
  "AIClient": { "TimeoutSeconds": 90 },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000",
        "Protocols": "Http1"
      }
    }
  },
  "GrpcServices": {
    "AI": "http://ai:5008",
    "Ordering": "http://ordering:5004",
    "Restaurant": "http://restaurant:5002",
    "Catalog": "http://catalog:5003",
    "Inventory": "http://inventory:5006"
  },
  "CatalogClient": {
    "TimeoutSeconds": 10
  },
  "OrderingClient": {
    "TimeoutSeconds": 30
  }
}
