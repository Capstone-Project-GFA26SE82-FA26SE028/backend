{
  "AllowedHosts": "*",
  "GrpcServices": {
    "Ordering": "http://ordering:5004",
    "Identity": "http://identity:5001",
    "Restaurant": "http://restaurant:5002"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Protocols": "Http2",
        "Url": "http://0.0.0.0:5003"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "Default": "Information"
    }
  },
  "CatalogManagement": {
    "MenuManagerRoleIds": [
      "manager"
    ],
    "MenuReaderRoleIds": [
      "waiter"
    ],
    "KitchenRoleIds": [
      "kitchen"
    ],
    "NonSellingItemAvailabilities": [
      "Inactive"
    ],
    "IdentityTimeoutSeconds": 5
  },
  "ItemManagement": {
    "InitialAvailability": "Inactive"
  },
  "Pricing": {
    "AllChannelsCode": "AllChannels",
    "Channels": [
      "DineIn"
    ],
    "BusinessTimeZone": "Asia/Ho_Chi_Minh"
  }
}
