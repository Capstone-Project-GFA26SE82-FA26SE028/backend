{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5006",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=InventoryDb_Local;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "GrpcServices": {
    "Identity": "https://localhost:5001",
    "Restaurant": "https://localhost:5002"
  },
  "InventoryAccess": {
    "ManagerRoleIds": [
      "manager"
    ],
    "ReceiverRoleIds": [
      "inventory"
    ],
    "ReaderRoleIds": [
      "manager",
      "inventory"
    ],
    "IssuerRoleIds": [
      "inventory"
    ],
    "CookingRoleIds": [
      "kitchen",
      "manager",
      "admin"
    ]
  }
}
