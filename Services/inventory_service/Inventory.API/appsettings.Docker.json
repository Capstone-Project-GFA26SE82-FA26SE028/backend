{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Protocols": "Http2",
        "Url": "http://0.0.0.0:5006"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "Default": "Information"
    }
  },
  "GrpcServices": {
    "Identity": "http://identity:5001"
  },
  "InventoryAccess": {
    "ManagerRoleIds": [
      "manager"
    ],
    "ReceiverRoleIds": [
      "inventory"
    ],
    "ReaderRoleIds": [
      "manager",
      "inventory"
    ],
    "IssuerRoleIds": [
      "inventory"
    ],
    "CookingRoleIds": [
      "kitchen",
      "manager",
      "admin"
    ]
  }
}
