<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inventory.BLL\Inventory.BLL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../Contracts/Protos/identity.proto" Link="Protos/identity.proto" GrpcServices="Client" />
    <Protobuf Include="../../../Contracts/Protos/inventory.proto" Link="Protos/inventory.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>

