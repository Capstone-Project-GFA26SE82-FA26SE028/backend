<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AI.BLL/AI.BLL.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <Protobuf Include="Protos/assistant.proto" GrpcServices="Both" />
    <Protobuf Include="../../../Contracts/Protos/catalog.proto" Link="Protos/catalog.proto" GrpcServices="Client" />
    <Protobuf Include="../../../Contracts/Protos/restaurant.proto" Link="Protos/restaurant.proto" GrpcServices="Client" />
    <Protobuf Include="../../../Contracts/Protos/ordering.proto" Link="Protos/ordering.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
