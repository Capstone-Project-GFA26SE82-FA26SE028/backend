{
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5008",
        "Protocols": "Http2"
      },
      "Health": {
        "Url": "http://localhost:5009",
        "Protocols": "Http1"
      }
    }
  },
  "GrpcServices": {
    "Restaurant": "https://localhost:5002",
    "Catalog": "https://localhost:5003",
    "Ordering": "https://localhost:5004"
  },
  "AI": {
    "Channel": "DineIn",
    "Currency": "VND",
    "DuplicatePolicy": "ItemId",
    "RequestTimeoutSeconds": 90,
    "DependencyTimeoutSeconds": 10,
    "MaximumConcurrentInferences": 1,
    "MaximumSuggestions": 3,
    "MaximumMenuItems": 200,
    "MenuPageSize": 50,
    "ModelCandidateCount": 8,
    "MaximumMessageLength": 500,
    "MaximumHistoryTurns": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Gemini": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta",
    "ApiKey": "",
    "Model": "gemini-3.1-flash-lite",
    "MaximumOutputTokens": 2048,
    "MaximumPromptCharacters": 5000,
    "Temperature": 1,
    "ThinkingLevel": "minimal"
  }
}
