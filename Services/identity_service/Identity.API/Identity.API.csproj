<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Identity.BLL\Identity.BLL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\Contracts\Protos\identity.proto"
              Link="Protos\identity.proto"
              GrpcServices="Server" />
    <Protobuf Include="../../../Contracts/Protos/restaurant.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../Contracts/Protos/notifications.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>

