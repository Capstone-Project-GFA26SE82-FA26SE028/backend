{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Jwt": {
    "AccessTokenMinutes": 15,
    "SessionHours": 12
  },
  "UserManagement": {
    "AdminRoleIds": [
      "admin"
    ]
  }
}
