# Copy to .env; set SQL credentials and a random JWT secret.
# SQL Server on host: enable TCP and use its actual port.
# Single quotes preserve literal dollar signs.
IDENTITY_DB_CONNECTION='Server=host.docker.internal,1433;Database=YOUR_EXISTING_DATABASE;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True'
JWT_SECRET_KEY=''
JWT_ISSUER=backend-identity
JWT_AUDIENCE=backend-clients
GATEWAY_HTTP_PORT=5000
