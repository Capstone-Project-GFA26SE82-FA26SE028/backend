# Copy to .env and fill in credentials.
SQL_SA_PASSWORD=
JWT_SECRET_KEY=
JWT_ISSUER=backend-identity
JWT_AUDIENCE=backend-clients
GATEWAY_HTTP_PORT=5000
CATALOG_MENU_MANAGER_ROLE_ID='manager'
QR_MENU_BASE_URL='http://localhost:5173/menu'
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same random secret (at least 32 characters) used only between Ordering and Billing.
TAKEAWAY_SERVICE_KEY=

PAYOS_WEBHOOK_BASE_URL=

# Optional separate internal key (32+ characters); defaults to JWT_SECRET_KEY in Docker.
STAFF_PROVISIONING_SERVICE_KEY=

# Optional internal notification key (32+ characters); Docker defaults to JWT_SECRET_KEY.
NOTIFICATION_SERVICE_KEY=

# Gemini API key for the AI service (optional for other backend features).
GEMINI_API_KEY=
