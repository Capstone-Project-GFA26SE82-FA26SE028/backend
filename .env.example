# Copy to .env; set SQL credentials and a random JWT secret.
# SQL Server on host: enable TCP and use its actual port.
# Single quotes preserve literal dollar signs.
IDENTITY_DB_CONNECTION='Server=host.docker.internal,1433;Database=YOUR_EXISTING_DATABASE;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True'
JWT_SECRET_KEY=''
JWT_ISSUER=backend-identity
JWT_AUDIENCE=backend-clients
GATEWAY_HTTP_PORT=5000

# Required when starting the optional services profile. Use SQL login and host.docker.internal for host SQL.
RESTAURANT_DB_CONNECTION=''
QR_MENU_BASE_URL='http://localhost:5173/menu'
CATALOG_DB_CONNECTION=''
CATALOG_MENU_MANAGER_ROLE_ID=''
CATALOG_KITCHEN_ROLE_ID='kitchen'
CATALOG_NON_SELLING_AVAILABILITY='Inactive'
CATALOG_INITIAL_AVAILABILITY='Inactive'
ORDERING_DB_CONNECTION=''
CUSTOMER_DB_CONNECTION=''
INVENTORY_DB_CONNECTION=''
BILLING_DB_CONNECTION=''
